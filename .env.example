# ==========================================
# TERANGA SHOP DAKAR - CONFIGURATION SERVEUR
# ==========================================

# Environnement (development | production)
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Sécurité & Authentification
# IMPORTANT : Générez une clé secrète longue et aléatoire en production
JWT_SECRET=super_secret_jwt_key_teranga_shop_dakar_2026_change_in_prod
JWT_EXPIRES_IN=7d

# Base de Données
DB_FILE_PATH=database.sqlite

# Paramètres de Paiement (Sénégal)
# Mode : 'test' (démonstration sécurisée) ou 'live' (vrais paiements avec API réelles)
PAYMENT_MODE=test

# Wave Sénégal API (identifiants réels en production)
WAVE_API_KEY=
WAVE_BUSINESS_ID=
WAVE_WEBHOOK_SECRET=

# Orange Money Sénégal API (identifiants réels en production)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# PayTech Sénégal API (option agrégateur cartes + wave + OM)
PAYTECH_API_KEY=
PAYTECH_API_SECRET=

# Configuration Magasin & Notifications
STORE_NAME="Teranga Shop Dakar"
STORE_PHONE="+221 77 123 45 67"
STORE_WHATSAPP="221771234567"
STORE_EMAIL="contact@terangashop.sn"
STORE_ADDRESS="Rue Aimé Césaire, Fann Résidence, Dakar, Sénégal"
DEFAULT_CURRENCY="FCFA"

# Création Premier Administrateur (Optionnel via script create-admin)
ADMIN_DEFAULT_EMAIL=admin@terangashop.sn
ADMIN_DEFAULT_PASSWORD=
