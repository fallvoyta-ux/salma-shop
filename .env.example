# ==========================================
# SALMA SHOP - GLOBAL BUSINESS SERVICES GRP SF
# Copiez ce fichier en .env et remplissez les valeurs.
# NE JAMAIS versionner le fichier .env (il est dans .gitignore).
# ==========================================

# Environnement (development | production)
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Sécurité & Authentification ---
# OBLIGATOIRE en production : 32 caractères minimum, sinon le serveur refuse de démarrer.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Base de données ---
# En local, laisser DATABASE_URL vide : SQLite est utilisé automatiquement.
# En production, fournir une URL PostgreSQL (Neon, Supabase, Render Postgres).
# ⚠️ Sans DATABASE_URL sur Render, les données sont perdues à chaque déploiement.
DATABASE_URL=
DB_FILE_PATH=database.sqlite

# --- Stockage des images produits ---
# Sans CLOUDINARY_URL, les images sont écrites sur le disque local
# et disparaissent à chaque redéploiement sur Render.
# Format : cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Premier administrateur ---
# Créé automatiquement au premier démarrage si la base est vide.
# Un administrateur déjà existant n'est JAMAIS écrasé.
# Le mot de passe doit faire 10 caractères minimum.
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# --- Paiements ---
# 'test' = démonstration (aucun argent réel n'est encaissé)
# 'live' = vrais paiements ; exige WAVE_WEBHOOK_SECRET, sinon le serveur refuse de démarrer.
PAYMENT_MODE=test

# Wave Sénégal
WAVE_API_KEY=
WAVE_BUSINESS_ID=
WAVE_WEBHOOK_SECRET=

# Orange Money Sénégal
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# PayTech Sénégal (agrégateur cartes + Wave + OM)
PAYTECH_API_KEY=
PAYTECH_API_SECRET=

# --- Informations boutique ---
STORE_NAME="Salma Shop"
STORE_PHONE="+221 77 201 86 97"
STORE_WHATSAPP="221772018697"
STORE_EMAIL="contact@salmashop.sn"
STORE_ADDRESS="Dakar, Sénégal"
DEFAULT_CURRENCY="FCFA"
