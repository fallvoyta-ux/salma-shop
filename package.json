{
  "name": "boutique-senegal-ecommerce",
  "version": "1.0.0",
  "description": "Application e-commerce professionnelle pour le Sénégal avec Wave, Orange Money, gestion des stocks et espace administrateur complet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev:server": "node src/server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "start": "node src/server/index.js",
    "db:seed": "node src/server/db/seed.js",
    "create-admin": "node src/server/scripts/createAdmin.js",
    "test": "node src/server/tests/test_api.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
